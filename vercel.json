{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/shop.html",
      "destination": "/shop/index.html",
      "permanent": true
    },
    {
      "source": "/product.html",
      "destination": "/shop/product.html",
      "permanent": true
    },
    {
      "source": "/categories.html",
      "destination": "/shop/categories.html",
      "permanent": true
    },
    {
      "source": "/cart.html",
      "destination": "/shop/cart.html",
      "permanent": true
    },
    {
      "source": "/checkout.html",
      "destination": "/shop/checkout.html",
      "permanent": true
    },
    {
      "source": "/account.html",
      "destination": "/account/index.html",
      "permanent": true
    },
    {
      "source": "/orders.html",
      "destination": "/account/orders.html",
      "permanent": true
    },
    {
      "source": "/order.html",
      "destination": "/account/order.html",
      "permanent": true
    },
    {
      "source": "/favorites.html",
      "destination": "/account/favorites.html",
      "permanent": true
    },
    {
      "source": "/login.html",
      "destination": "/auth/login.html",
      "permanent": true
    },
    {
      "source": "/register.html",
      "destination": "/auth/register.html",
      "permanent": true
    },
    {
      "source": "/reset-password.html",
      "destination": "/auth/reset-password.html",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/pages/about.html",
      "permanent": true
    },
    {
      "source": "/help.html",
      "destination": "/pages/help.html",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/pages/privacy.html",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/pages/contact.html",
      "permanent": true
    }
  ]
}
